# 打印机凭据（真实值只存在本地）
.env

# Node 依赖
node_modules/

# 调试截图（README 用到的已挑进 docs/）
.preview/
*.log

# APK 构建中间产物
apk/build/

# APK 的签名密钥与分离签名文件
