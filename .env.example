# 复制这份文件为 .env，填上你自己的打印机信息：
#   cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交进仓库。

# 打印机 IP —— 打印机屏幕：设置 → 网络
PRINTER_IP=192.168.1.100

# 8 位访问码 —— 同一页往下，「局域网模式(LAN Only)」那一块
PRINTER_CODE=

# 可选：序列号。填了启动更快，不填也能从报文里自动识别
PRINTER_SERIAL=

# 可选：机型。影响显示名和摄像头通道，留空就按通用配置（RTSPS 322）尝试。
# 可选值（不区分大小写）：
#   P2S  P1S  P1P  X1C  X1E  X2D  A1  A1M  A2L  H2D  H2S  H2C
# 注意：P1 / A1 / A2 系列的摄像头是 6000 端口 JPEG 推流，与 P2S 不是同一套
# 协议，当前版本看不了画面（状态和控制正常）；P1P 没有摄像头。
PRINTER_MODEL=
